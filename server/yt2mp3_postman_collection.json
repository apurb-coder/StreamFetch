	"event": [
		{
			"listen": "prerequest",
			"script": {
				"type": "text/javascript",
				"exec": [
					"const baseUrl = pm.collectionVariables.get(\"baseUrl\") || \"http://localhost:3000\";",
					"const clientSecretFormula = pm.collectionVariables.get(\"clientSecretFormula\") || \"yt2mp3_dynamic_secure_formula_salt_2026\";",
					"const adminApiKey = pm.collectionVariables.get(\"adminApiKey\") || \"my_secure_admin_api_key\";",
					"",
					"// 1. Check if user is using Admin API Key bypass",
					"const hasApiKeyHeader = pm.request.headers.get(\"x-api-key\");",
					"const useAdminBypass = hasApiKeyHeader && hasApiKeyHeader === adminApiKey;",
					"",
					"// 2. If bypassing, calling handshake/proxy/health routes, or checking status, skip signature generation",
					"const path = pm.request.url.getPath();",
					"const skipPaths = [\"/api/handshake\", \"/api/proxy\", \"/health\", \"/\", \"\"];",
					"const shouldSkip = useAdminBypass || skipPaths.includes(path) || path.startsWith(\"/api/extract/status/\");",
					"",
					"if (!shouldSkip) {",
					"    const now = Date.now();",
					"    let token = pm.globals.get(\"yt2mp3_appToken\");",
					"    let expiry = pm.globals.get(\"yt2mp3_appTokenExpiry\");",
					"",
					"    const fetchTokenAndSign = () => {",
					"        const handshakeUrl = `${baseUrl}/api/handshake`;",
					"        pm.sendRequest({",
					"            url: handshakeUrl,",
					"            method: 'GET',",
					"            header: {",
					"                'User-Agent': 'Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/120.0.0.0 Safari/537.36'",
					"            }",
					"        }, function (err, res) {",
					"            if (err) {",
					"                console.error(\"[Postman Pre-request] Failed to fetch handshake token:\", err);",
					"                return;",
					"            }",
					"            const json = res.json();",
					"            if (json && json.success) {",
					"                token = json.token;",
					"                expiry = Date.now() + (json.expiresInMs || 900000);",
					"                ",
					"                pm.globals.set(\"yt2mp3_appToken\", token);",
					"                pm.globals.set(\"yt2mp3_appTokenExpiry\", expiry);",
					"                ",
					"                console.log(\"[Postman Pre-request] Fresh token successfully acquired:\", token);",
					"                signRequest(token);",
					"            } else {",
					"                console.error(\"[Postman Pre-request] Handshake was unsuccessful:\", json);",
					"            }",
					"        });",
					"    };",
					"",
					"    const signRequest = (appToken) => {",
					"        const timestamp = Date.now().toString();",
					"        let requestUrlParam = \"\";",
					"        ",
					"        if (pm.request.body && pm.request.body.mode === \"raw\") {",
					"            try {",
					"                const body = JSON.parse(pm.request.body.raw);",
					"                if (body && body.url) {",
					"                    requestUrlParam = body.url;",
					"                }",
					"            } catch (e) {",
					"                // Non-JSON or missing URL",
					"            }",
					"        }",
					"        ",
					"        // SHA256(token + timestamp + url + clientSecretFormula)",
					"        const inputString = appToken + timestamp + requestUrlParam + clientSecretFormula;",
					"        const signature = CryptoJS.SHA256(inputString).toString(CryptoJS.enc.Hex);",
					"        ",
					"        pm.request.headers.upsert({ key: \"x-app-token\", value: appToken });",
					"        pm.request.headers.upsert({ key: \"x-app-timestamp\", value: timestamp });",
					"        pm.request.headers.upsert({ key: \"x-app-signature\", value: signature });",
					"        ",
					"        console.log(\"[Postman Pre-request] Applied signature:\", signature);",
					"    };",
					"",
					"    if (!token || !expiry || now > parseInt(expiry, 10)) {",
					"        console.log(\"[Postman Pre-request] Token expired or missing. Fetching new handshake token...\");",
					"        fetchTokenAndSign();",
					"    } else {",
					"        console.log(\"[Postman Pre-request] Reusing cached token:\", token);",
					"        signRequest(token);",
					"    }",
					"}"
				]
			}
		}
	],
