# ==========================================
# YouTube Downloader Backend - Environment Variables
# Duplicate this file as '.env' and fill in your values
# ==========================================

# Runtime configuration
NODE_ENV=development
PORT=3000

# Security
# Set this to a secure random string to protect system statistics endpoints
ADMIN_API_KEY=your_super_secure_admin_api_key_here

# CORS allowed origins (comma-separated list). Defaults to local dev servers if blank.
# ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173

# Dynamic client-secret formula salt used for HMAC request handshakes.
# In production, replace this with a strong, custom random passphrase.
# CLIENT_SECRET_FORMULA=yt2mp3_dynamic_secure_formula_salt_2026

# Token expiration duration in milliseconds (default is 900000 ms / 15 minutes)
# TOKEN_EXPIRY_MS=900000

# Redis database connection (used for queues and rate-limiter)
REDIS_URL=redis://localhost:6379

# Worker pool configuration
# Maximum number of parallel yt-dlp threads to run (keep high only on multi-core servers)
MAX_WORKERS=4
# Max time in milliseconds allowed for a single extraction job (25 seconds default)
EXTRACTION_TIMEOUT=25000

# yt-dlp binary configuration
# On windows, specify path to yt-dlp.exe. On Alpine Docker, it's typically '/usr/bin/yt-dlp'
# If left blank, it will attempt to find 'yt-dlp' in the global PATH environment
YT_DLP_PATH=yt-dlp

# Proxy rotation configuration (Comma-separated lists)
# 1. Webshare paid/free proxies (e.g., http://user:pass@host:port)
WEBSHARE_PROXIES=
# 2. Oracle Cloud custom/free proxy servers
ORACLE_PROXIES=
# 3. Tor Proxy config (Set to true if a local socks5 tor instance runs at port 9050)
USE_TOR=false


# Redis container performance settings
REDIS_MAX_MEMORY=256mb
REDIS_MAX_MEMORY_POLICY=noeviction

# Docker host ports mapping
TOR_PORT=9050

# Resource Allocation Limits inside Docker container
CPU_LIMIT=2
MEMORY_LIMIT=512M
CPU_RESERVATION=1
MEMORY_RESERVATION=256M

#PoToken service URL
PO_TOKEN_SERVER_URL=